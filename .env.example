# ==============================================================================
# MediMate - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file and rename it to `.env` in the project root:
#    cp .env.example .env  (or copy-paste in VS Code)
# 2. Fill in your own real values in `.env`.
# 3. NEVER commit your actual `.env` file or secrets to version control.
# ==============================================================================

# Server configuration
PORT=5000
NODE_ENV=development

# Database Configuration (Planned for Phase 2 - MongoDB Atlas)
# Replace with your actual connection string when setting up Phase 2
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/medimate?retryWrites=true&w=majority

# Authentication Secret (Planned for Phase 2 - JWT)
# Use a strong, random secret phrase for signing tokens in production
JWT_SECRET=your_jwt_secret_key_here_minimum_32_characters
JWT_EXPIRES_IN=7d

# Optional Private Cloud Object Storage (Cloudinary)
# If unconfigured, MediMate securely stores documents in local private storage (uploads/medical-reports/)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Web Push & Background Scheduler (Phase 10 & 11)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:admin@example.com
CRON_SECRET=your_external_cron_secret_token_here

